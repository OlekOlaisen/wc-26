# Leave unset — the app uses /api (Vite proxy locally, Netlify proxy in production).
# Do not set this to https://worldcup26.ir on Netlify; the API does not allow browser CORS.
# VITE_API_BASE_URL=/api
#
# Optional JWT if the API requires authentication:
# VITE_API_TOKEN=your_token_here
#
# API-Football (api-sports.io) — player photos on Top scorers. Never commit the real key.
# Local dev: Vite proxies /api-football and sends this header. Netlify: set in site env vars.
# API_FOOTBALL_KEY=your_api_football_key
